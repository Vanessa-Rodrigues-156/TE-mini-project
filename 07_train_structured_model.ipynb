   "outputs": [],
   "source": [
    "def predict_adr_suitability(act_name, case_type, source='unknown', year=2024, court_level=0):\n",
    "    \"\"\"\n",
    "    Predict ADR suitability for a new case.\n",
    "    \n",
    "    Args:\n",
    "        act_name: Name of the act (string)\n",
    "        case_type: Type of case (string)\n",
    "        source: Source of case (DDL, HC, SC)\n",
    "        year: Year of case\n",
    "        court_level: Court level (numeric)\n",
    "    \n",
    "    Returns:\n",
    "        Prediction: 0 (Not suitable), 1 (ADR suitable)\n",
    "        Probability: Confidence scores\n",
    "    \"\"\"\n",
    "    # Create input dataframe\n",
    "    input_data = pd.DataFrame({\n",
    "        'act_name': [act_name],\n",
    "        'case_type': [case_type],\n",
    "        'source': [source],\n",
    "        'year': [year],\n",
    "        'court_level': [court_level]\n",
    "    })\n",
    "    \n",
    "    # Select only available features\n",
    "    input_data = input_data[[col for col in FEATURE_COLS if col in input_data.columns]]\n",
    "    \n",
    "    # Fill missing values\n",
    "    for col in input_data.select_dtypes(include='object').columns:\n",
    "        input_data[col] = input_data[col].fillna('Unknown')\n",
    "    for col in input_data.select_dtypes(include=['int64', 'float64']).columns:\n",
    "        input_data[col] = input_data[col].fillna(X_encoded[col].median())\n",
    "    \n",
    "    # Encode categorical features\n",
    "    for col in input_data.select_dtypes(include='object').columns:\n",
    "        if col in label_encoders:\n",
    "            try:\n",
    "                input_data[col] = label_encoders[col].transform(input_data[col].astype(str))\n",
    "            except:\n",
    "                # Handle unknown categories\n",
    "                input_data[col] = 0\n",
    "    \n",
    "    # Make prediction\n",
    "    prediction = best_model.predict(input_data)[0]\n",
    "    probability = best_model.predict_proba(input_data)[0]\n",
    "    \n",
    "    return {\n",
    "        'prediction': prediction,\n",
    "        'label': 'ADR Suitable' if prediction == 1 else 'Not Suitable',\n",
    "        'probability_not_suitable': probability[0],\n",
    "        'probability_adr_suitable': probability[1]\n",
    "    }\n",
    "\n",
    "print(\"Prediction function created!\")"
   ]
