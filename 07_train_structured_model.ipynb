{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# ADR/ODR Suitability Classifier — Model Training (Structured)\n",
    "\n",
    "## Overview\n",
    "Train a **structured model** using Random Forest and XGBoost on:\n",
    "- **Features**: `act_name`, `case_type`, and derived categorical features\n",
    "- **Target**: `adr_target` (binary: -1/0/1) or `odr_target`\n",
    "\n",
    "This notebook assumes you have `training_data.parquet` loaded from your Google Drive."
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 1: Setup and Data Loading"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Mount Google Drive (if running on Colab)\n",
    "import sys\n",
    "if 'google.colab' in sys.modules:\n",
    "    from google.colab import drive\n",
    "    drive.mount('/content/drive')\n",
    "    print(\"Google Drive mounted at /content/drive\")\n",
    "    data_path = '/content/drive/My Drive/compiled_dataset'  # Adjust path as needed\n",
    "else:\n",
    "    data_path = './compiled_dataset'  # Local path\n",
    "    print(f\"Running locally, using path: {data_path}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "from sklearn.model_selection import train_test_split, cross_val_score, GridSearchCV\n",
    "from sklearn.preprocessing import LabelEncoder, StandardScaler\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import (\n",
    "    classification_report, confusion_matrix, roc_auc_score, \n",
    "    roc_curve, f1_score, precision_recall_curve, auc\n",
    ")\n",
    "from imblearn.over_sampling import SMOTE\n",
    "from imblearn.pipeline import Pipeline as ImbPipeline\n",
    "import xgboost as xgb\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from tqdm import tqdm\n",
    "\n",
    "print(\"Dependencies loaded successfully!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load the training data\n",
    "print(\"Loading training_data.parquet...\")\n",
    "df = pd.read_parquet(f'{data_path}/training_data.parquet')\n",
    "\n",
    "print(f\"\\nDataset shape: {df.shape}\")\n",
    "print(f\"\\nColumn names:\\n{df.columns.tolist()}\")\n",
    "print(f\"\\nFirst few rows:\")\n",
    "df.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Data info and missing values\n",
    "print(\"Missing values:\")\n",
    "print(df.isnull().sum())\n",
    "print(f\"\\nData types:\")\n",
    "print(df.dtypes)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 2: Target Variable Selection and Exploration"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check available target columns\n",
    "target_cols = [col for col in df.columns if 'target' in col.lower() or 'label' in col.lower()]\n",
    "print(f\"Available target columns: {target_cols}\")\n",
    "\n",
    "# Display value counts for each\n",
    "for col in target_cols:\n",
    "    print(f\"\\n{col} distribution:\")\n",
    "    print(df[col].value_counts(dropna=False).sort_index())\n",
    "    print(f\"Percentage:\\n{df[col].value_counts(normalize=True, dropna=False).sort_index() * 100}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# We'll use adr_target as primary target (can switch to odr_target)\n",
    "TARGET = 'adr_target'\n",
    "print(f\"Using target: {TARGET}\")\n",
    "\n",
    "# Remove rows with -1 (unknown) labels for training\n",
    "df_clean = df[df[TARGET] != -1].copy()\n",
    "print(f\"\\nAfter removing unknown labels (-1):\")\n",
    "print(f\"Dataset shape: {df_clean.shape}\")\n",
    "print(f\"\\nTarget distribution:\\n{df_clean[TARGET].value_counts()}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 3: Feature Engineering and Selection"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Identify available features\n",
    "print(\"Categorical features in dataset:\")\n",
    "cat_cols = df_clean.select_dtypes(include='object').columns.tolist()\n",
    "print(cat_cols)\n",
    "\n",
    "print(\"\\nNumerical features in dataset:\")\n",
    "num_cols = df_clean.select_dtypes(include=['int64', 'float64']).columns.tolist()\n",
    "# Remove target columns from features\n",
    "num_cols = [col for col in num_cols if col not in ['adr_target', 'odr_target', 'final_label']]\n",
    "print(num_cols)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Primary features for structured model\n",
    "FEATURE_COLS = []\n",
    "\n",
    "# Add key categorical features\n",
    "key_cat_features = ['act_name', 'case_type', 'source']\n",
    "for feat in key_cat_features:\n",
    "    if feat in cat_cols:\n",
    "        FEATURE_COLS.append(feat)\n",
    "        print(f\"\\n{feat} unique values: {df_clean[feat].nunique()}\")\n",
    "\n",
    "# Add numerical features if available\n",
    "key_num_features = ['year', 'court_level']\n",
    "for feat in key_num_features:\n",
    "    if feat in num_cols:\n",
    "        FEATURE_COLS.append(feat)\n",
    "        print(f\"\\n{feat} - min: {df_clean[feat].min()}, max: {df_clean[feat].max()}\")\n",
    "\n",
    "print(f\"\\nSelected features: {FEATURE_COLS}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Check for missing values in features and target\n",
    "print(\"Missing values in selected features and target:\")\n",
    "missing_info = pd.DataFrame({\n",
    "    'column': FEATURE_COLS + [TARGET],\n",
    "    'missing_count': [df_clean[col].isnull().sum() for col in FEATURE_COLS + [TARGET]],\n",
    "    'missing_pct': [df_clean[col].isnull().sum() / len(df_clean) * 100 for col in FEATURE_COLS + [TARGET]]\n",
    "})\n",
    "print(missing_info)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Prepare data: handle missing values\n",
    "X = df_clean[FEATURE_COLS].copy()\n",
    "y = df_clean[TARGET].copy()\n",
    "\n",
    "# Fill missing categorical values with 'Unknown'\n",
    "for col in X.select_dtypes(include='object').columns:\n",
    "    X[col] = X[col].fillna('Unknown')\n",
    "\n",
    "# Fill missing numerical values with median\n",
    "for col in X.select_dtypes(include=['int64', 'float64']).columns:\n",
    "    X[col] = X[col].fillna(X[col].median())\n",
    "\n",
    "print(f\"X shape: {X.shape}\")\n",
    "print(f\"y shape: {y.shape}\")\n",
    "print(f\"\\nMissing values after imputation:\")\n",
    "print(X.isnull().sum())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Encode categorical features\n",
    "label_encoders = {}\n",
    "X_encoded = X.copy()\n",
    "\n",
    "for col in X.select_dtypes(include='object').columns:\n",
    "    le = LabelEncoder()\n",
    "    X_encoded[col] = le.fit_transform(X[col].astype(str))\n",
    "    label_encoders[col] = le\n",
    "    print(f\"\\n{col}: {len(le.classes_)} unique values encoded\")\n",
    "\n",
    "print(f\"\\nEncoded features:\")\n",
    "print(X_encoded.head())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 4: Train-Test Split and Class Balance Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Split data: 80% train, 20% test\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X_encoded, y, test_size=0.2, random_state=42, stratify=y\n",
    ")\n",
    "\n",
    "print(f\"Train set size: {X_train.shape[0]}\")\n",
    "print(f\"Test set size: {X_test.shape[0]}\")\n",
    "print(f\"\\nTrain target distribution:\\n{y_train.value_counts().sort_index()}\")\n",
    "print(f\"\\nTest target distribution:\\n{y_test.value_counts().sort_index()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize class imbalance\n",
    "fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n",
    "\n",
    "y_train.value_counts().sort_index().plot(kind='bar', ax=axes[0], color=['#ff6b6b', '#4ecdc4'])\n",
    "axes[0].set_title('Train Set - Class Distribution')\n",
    "axes[0].set_xlabel('Label')\n",
    "axes[0].set_ylabel('Count')\n",
    "axes[0].grid(axis='y', alpha=0.3)\n",
    "\n",
    "y_test.value_counts(normalize=True).sort_index().plot(kind='bar', ax=axes[1], color=['#ff6b6b', '#4ecdc4'])\n",
    "axes[1].set_title('Test Set - Class Distribution (%)')\n",
    "axes[1].set_xlabel('Label')\n",
    "axes[1].set_ylabel('Percentage')\n",
    "axes[1].grid(axis='y', alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(\"\\nClass Imbalance Info:\")\n",
    "print(f\"Minority class ratio in train: {(y_train.value_counts().min() / len(y_train) * 100):.2f}%\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 5: Train Baseline Random Forest Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train baseline Random Forest\n",
    "print(\"Training baseline Random Forest...\")\n",
    "rf_baseline = RandomForestClassifier(\n",
    "    n_estimators=100,\n",
    "    max_depth=15,\n",
    "    min_samples_split=10,\n",
    "    min_samples_leaf=5,\n",
    "    random_state=42,\n",
    "    n_jobs=-1,\n",
    "    verbose=1\n",
    ")\n",
    "\n",
    "rf_baseline.fit(X_train, y_train)\n",
    "print(\"Training complete!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluate baseline model\n",
    "y_pred_rf = rf_baseline.predict(X_test)\n",
    "y_pred_proba_rf = rf_baseline.predict_proba(X_test)\n",
    "\n",
    "print(\"Random Forest Baseline - Classification Report:\")\n",
    "print(classification_report(y_test, y_pred_rf))\n",
    "\n",
    "print(f\"\\nAccuracy: {(y_pred_rf == y_test).mean():.4f}\")\n",
    "print(f\"F1 Score: {f1_score(y_test, y_pred_rf):.4f}\")\n",
    "try:\n",
    "    print(f\"ROC-AUC: {roc_auc_score(y_test, y_pred_proba_rf[:, 1]):.4f}\")\n",
    "except:\n",
    "    print(\"ROC-AUC: Not available for multiclass\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Feature importance from Random Forest\n",
    "feature_importance_rf = pd.DataFrame({\n",
    "    'feature': FEATURE_COLS,\n",
    "    'importance': rf_baseline.feature_importances_\n",
    "}).sort_values('importance', ascending=False)\n",
    "\n",
    "print(\"\\nRandom Forest - Feature Importance:\")\n",
    "print(feature_importance_rf)\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.barh(feature_importance_rf['feature'], feature_importance_rf['importance'], color='#4ecdc4')\n",
    "plt.xlabel('Importance')\n",
    "plt.title('Random Forest - Feature Importance')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 6: Train XGBoost Model with Hyperparameter Tuning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train baseline XGBoost\n",
    "print(\"Training baseline XGBoost...\")\n",
    "xgb_baseline = xgb.XGBClassifier(\n",
    "    n_estimators=100,\n",
    "    max_depth=5,\n",
    "    learning_rate=0.1,\n",
    "    random_state=42,\n",
    "    n_jobs=-1,\n",
    "    verbosity=1\n",
    ")\n",
    "\n",
    "xgb_baseline.fit(X_train, y_train, eval_set=[(X_test, y_test)], verbose=False)\n",
    "print(\"Training complete!\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluate baseline XGBoost\n",
    "y_pred_xgb = xgb_baseline.predict(X_test)\n",
    "y_pred_proba_xgb = xgb_baseline.predict_proba(X_test)\n",
    "\n",
    "print(\"XGBoost Baseline - Classification Report:\")\n",
    "print(classification_report(y_test, y_pred_xgb))\n",
    "\n",
    "print(f\"\\nAccuracy: {(y_pred_xgb == y_test).mean():.4f}\")\n",
    "print(f\"F1 Score: {f1_score(y_test, y_pred_xgb):.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Feature importance from XGBoost\n",
    "feature_importance_xgb = pd.DataFrame({\n",
    "    'feature': FEATURE_COLS,\n",
    "    'importance': xgb_baseline.feature_importances_\n",
    "}).sort_values('importance', ascending=False)\n",
    "\n",
    "print(\"\\nXGBoost - Feature Importance:\")\n",
    "print(feature_importance_xgb)\n",
    "\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.barh(feature_importance_xgb['feature'], feature_importance_xgb['importance'], color='#ffa07a')\n",
    "plt.xlabel('Importance')\n",
    "plt.title('XGBoost - Feature Importance')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 7: Class Balancing with SMOTE"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Apply SMOTE to training data\n",
    "print(\"Applying SMOTE for class balancing...\")\n",
    "smote = SMOTE(random_state=42)\n",
    "X_train_smote, y_train_smote = smote.fit_resample(X_train, y_train)\n",
    "\n",
    "print(f\"\\nOriginal train distribution:\\n{y_train.value_counts().sort_index()}\")\n",
    "print(f\"\\nSMOTE balanced train distribution:\\n{y_train_smote.value_counts().sort_index()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train Random Forest with SMOTE\n",
    "print(\"Training Random Forest with SMOTE...\")\n",
    "rf_smote = RandomForestClassifier(\n",
    "    n_estimators=100,\n",
    "    max_depth=15,\n",
    "    min_samples_split=10,\n",
    "    min_samples_leaf=5,\n",
    "    random_state=42,\n",
    "    n_jobs=-1\n",
    ")\n",
    "\n",
    "rf_smote.fit(X_train_smote, y_train_smote)\n",
    "\n",
    "y_pred_rf_smote = rf_smote.predict(X_test)\n",
    "print(\"\\nRandom Forest with SMOTE - Classification Report:\")\n",
    "print(classification_report(y_test, y_pred_rf_smote))\n",
    "print(f\"\\nAccuracy: {(y_pred_rf_smote == y_test).mean():.4f}\")\n",
    "print(f\"F1 Score: {f1_score(y_test, y_pred_rf_smote):.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train XGBoost with SMOTE\n",
    "print(\"Training XGBoost with SMOTE...\")\n",
    "xgb_smote = xgb.XGBClassifier(\n",
    "    n_estimators=100,\n",
    "    max_depth=5,\n",
    "    learning_rate=0.1,\n",
    "    random_state=42,\n",
    "    n_jobs=-1\n",
    ")\n",
    "\n",
    "xgb_smote.fit(X_train_smote, y_train_smote)\n",
    "\n",
    "y_pred_xgb_smote = xgb_smote.predict(X_test)\n",
    "print(\"\\nXGBoost with SMOTE - Classification Report:\")\n",
    "print(classification_report(y_test, y_pred_xgb_smote))\n",
    "print(f\"\\nAccuracy: {(y_pred_xgb_smote == y_test).mean():.4f}\")\n",
    "print(f\"F1 Score: {f1_score(y_test, y_pred_xgb_smote):.4f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 8: Model Comparison"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Compare all models\n",
    "models = {\n",
    "    'RF Baseline': (rf_baseline, y_pred_rf),\n",
    "    'XGB Baseline': (xgb_baseline, y_pred_xgb),\n",
    "    'RF + SMOTE': (rf_smote, y_pred_rf_smote),\n",
    "    'XGB + SMOTE': (xgb_smote, y_pred_xgb_smote),\n",
    "}\n",
    "\n",
    "comparison_results = []\n",
    "for name, (model, preds) in models.items():\n",
    "    accuracy = (preds == y_test).mean()\n",
    "    f1 = f1_score(y_test, preds)\n",
    "    comparison_results.append({\n",
    "        'Model': name,\n",
    "        'Accuracy': accuracy,\n",
    "        'F1 Score': f1\n",
    "    })\n",
    "\n",
    "comparison_df = pd.DataFrame(comparison_results).sort_values('Accuracy', ascending=False)\n",
    "print(\"\\nModel Comparison:\")\n",
    "print(comparison_df.to_string(index=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize comparison\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "comparison_df.sort_values('Accuracy').plot(\n",
    "    x='Model', y='Accuracy', kind='barh', ax=axes[0], color='#4ecdc4', legend=False\n",
    ")\n",
    "axes[0].set_title('Model Accuracy Comparison')\n",
    "axes[0].set_xlabel('Accuracy')\n",
    "\n",
    "comparison_df.sort_values('F1 Score').plot(\n",
    "    x='Model', y='F1 Score', kind='barh', ax=axes[1], color='#ffa07a', legend=False\n",
    ")\n",
    "axes[1].set_title('Model F1 Score Comparison')\n",
    "axes[1].set_xlabel('F1 Score')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 9: Confusion Matrices and Detailed Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Confusion matrices for best models\n",
    "fig, axes = plt.subplots(2, 2, figsize=(12, 10))\n",
    "\n",
    "models_to_plot = [\n",
    "    ('RF Baseline', y_pred_rf),\n",
    "    ('XGB Baseline', y_pred_xgb),\n",
    "    ('RF + SMOTE', y_pred_rf_smote),\n",
    "    ('XGB + SMOTE', y_pred_xgb_smote),\n",
    "]\n",
    "\n",
    "for idx, (name, preds) in enumerate(models_to_plot):\n",
    "    ax = axes[idx // 2, idx % 2]\n",
    "    cm = confusion_matrix(y_test, preds)\n",
    "    sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', ax=ax, cbar=False)\n",
    "    ax.set_title(f'{name}\\nAccuracy: {(preds == y_test).mean():.4f}')\n",
    "    ax.set_ylabel('True Label')\n",
    "    ax.set_xlabel('Predicted Label')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown">
   "metadata": {},
   "source": [
    "## Step 10: Save Best Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pickle\n",
    "import os\n",
    "\n",
    "# Create models directory if it doesn't exist\n",
    "models_dir = f'{data_path}/models'\n",
    "os.makedirs(models_dir, exist_ok=True)\n",
    "\n",
    "# Save best model (XGB + SMOTE)\n",
    "best_model = xgb_smote\n",
